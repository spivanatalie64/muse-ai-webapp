# Absolute path to the geckodriver binary. Autodetected if unset.
# MUSE_GECKODRIVER=/usr/bin/geckodriver

# Absolute path to the Firefox binary. Defaults to the Arch system package.
# MUSE_FIREFOX_BINARY=/usr/lib/firefox/firefox

# Where the Firefox profile lives. The profile holds the signed-in Muse
# session, so it is never committed to the repository.
# MUSE_PROFILE_DIR=~/.local/share/muse-ai-webapp/firefox-profile

# Set to 1 to run Firefox with a visible window. Required for the interactive
# sign-in, since Muse has no API key: the user signs in to Muse in the window.
# MUSE_HEADED=1

# Override the CSS selectors used to find Muse's composer and messages.
# Comma-separated. Useful when Muse changes its markup.
# MUSE_COMPOSER_SELECTORS=[contenteditable="true"],textarea
# MUSE_MESSAGE_SELECTORS=[data-message-author-role]
